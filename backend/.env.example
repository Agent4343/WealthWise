# WealthWise Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Anthropic (Claude API) ────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Resend (Email) ────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=WealthWise <briefs@wealthwise.app>

# ── Apple Push Notifications (APNs) ──────────────────────────
# Key ID from Apple Developer Portal (10 chars)
APNS_KEY_ID=XXXXXXXXXX
# Your Apple Developer Team ID (10 chars)
APNS_TEAM_ID=XXXXXXXXXX
# PEM-encoded ES256 private key (contents of .p8 file)
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# iOS App Bundle ID
APNS_BUNDLE_ID=com.themoneyschool.wealthwise

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave empty for development)
ALLOWED_ORIGINS=
